Source: libruis-render-vulkan
Section: libs
Priority: extra
Maintainer: Ivan Gagis <igagis@gmail.com>
Build-Depends:
	debhelper (>= 9),
	prorab,
	prorab-extra,
	clang-format,
	clang-tidy,
	libruis-dev (>= 0.6.26),
	libvulkan-dev
Build-Depends-Indep: doxygen
Standards-Version: 3.9.2

Package: libruis-render-vulkan$(soname)
Section: libs
Architecture: any
Depends:
	${shlibs:Depends},
	${misc:Depends}
Description: Vulkan renderer for ruis.
	Vulkan renderer for ruis GUI library.

Package: libruis-render-vulkan-dbg$(soname)
Section: libs
Architecture: any
Depends:
	${shlibs:Depends},
	${misc:Depends}
Description: Vulkan renderer for ruis.
	Debug version of libruis-render-vulkan.

Package: libruis-render-vulkan$(soname)-dbgsrc
Section: debug
Architecture: all
Depends:
	libruis-render-vulkan$(soname)-dbgsym (= ${binary:Version}),
	libruis-render-vulkan-dbg$(soname)-dbgsym (= ${binary:Version}),
	${misc:Depends}
Description: debugging sources for libruis-render-vulkan$(soname) package.

Package: libruis-render-vulkan-dev
Section: libdevel
Architecture: any
Depends:
	libruis-render-vulkan$(soname) (= ${binary:Version}),
	libruis-render-vulkan-dbg$(soname) (= ${binary:Version}),
	libruis-dev,
	${misc:Depends}
Suggests: libruis-render-vulkan-doc
Description: Vulkan renderer for ruis.
	Vulkan renderer for ruis GUI library.

Package: libruis-render-vulkan-doc
Section: doc
Architecture: all
Depends: ${misc:Depends}
Description: documentation for libruis-render-vulkan library.
	For more details see description to libruis-render-vulkan-dev package.
